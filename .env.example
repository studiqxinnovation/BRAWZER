# ──────────────────────────────────────────────────────────────────────────────
# Brawzer environment template
#
# For local development:   cp .env.example .env
#
# Every value below is a LOCAL DEVELOPMENT default. None of them is a secret,
# and none may be reused in staging or production. Production values come from
# the hosting platform's secret manager, never from a committed file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Web app (apps/web · http://localhost:3100) ───────────────────────────────
# Public URL of the web app, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Where the web server forwards /api/v1/* requests. Server-side only.
API_INTERNAL_URL=http://127.0.0.1:4100
# The /design and /dev pages exist in development only. Set to "enabled" to
# include them in a production build, for a private staging review.
# BRAWZER_DEV_PAGES=enabled
# Search engines are blocked until launch. Set to "enabled" on the live site.
# SITE_INDEXING=enabled

# ── API (apps/api · http://localhost:4100) ───────────────────────────────────
API_HOST=127.0.0.1
API_PORT=4100
# Public URL of the web app. Email links point here, and requests from it are
# accepted. Over https the session cookie becomes Secure and __Host- prefixed.
WEB_ORIGIN=http://localhost:3100
# Extra origins allowed to send state-changing requests, comma-separated.
# 127.0.0.1:3100 is the same dev server under another name (used by the
# browser tests). Leave empty in production.
ALLOWED_ORIGINS=http://127.0.0.1:3100
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# json (production) or pretty (readable local logs)
LOG_FORMAT=pretty
# Serve interactive API docs at /api/docs. Always false in production.
API_DOCS_ENABLED=true
# Which reverse proxies may report the client's address (X-Forwarded-For):
# false, or a comma-separated list of proxy addresses/CIDRs. Rate limits and
# the security history use this address. Avoid "true" in production.
TRUST_PROXY=false
# Development multiplies every rate limit by this (default 20). Production
# always uses 1.
# RATE_LIMIT_SCALE=20

# ── Email ────────────────────────────────────────────────────────────────────
# mailpit (local inbox), resend (production) or log (no delivery, logs only).
EMAIL_TRANSPORT=mailpit
EMAIL_FROM=Brawzer <no-reply@brawzer.localhost>
MAILPIT_API_URL=http://127.0.0.1:8125
# Production only, from the secret manager: RESEND_API_KEY=re_...

# ── Accounts ─────────────────────────────────────────────────────────────────
# Refuse new passwords found in known data breaches (Pwned Passwords range API;
# only a 5-character hash prefix is sent). Default: on in production, off here.
# BREACHED_PASSWORD_CHECK=true
# Days the security history is kept (at least 30). Default 365.
# SECURITY_HISTORY_RETENTION_DAYS=365

# ── Encryption of secrets at rest (TOTP secrets, proxy credentials) ─────────
# local: key-encryption keys from ENCRYPTION_KEYS (development only; refused
# in production). vault: HashiCorp Vault / OpenBao Transit engine.
KEY_PROVIDER=local
# Comma-separated id:base64 256-bit keys; the first one encrypts new secrets.
# This key is a LOCAL DEVELOPMENT value only. Generate your own with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=local-1:6aF0J9oO7ZBUzIIQBOIb0fjRKnqOilzstf1+KGNeuYU=
# Local OpenBao (Vault-compatible) started by `pnpm infra:up`, used by the
# key-service tests. Production uses its own address and a scoped token.
OPENBAO_PORT=8210
VAULT_ADDR=http://127.0.0.1:8210
VAULT_TOKEN=brawzer_local_only
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TRANSIT_KEY=brawzer

# ── Local infrastructure (infra/compose, started with `pnpm infra:up`) ───────
# Ports are offset from the defaults so Brawzer can run beside other projects.
POSTGRES_PORT=5433
POSTGRES_USER=brawzer
POSTGRES_PASSWORD=brawzer_local_only
POSTGRES_DB=brawzer
DATABASE_URL=postgres://brawzer:brawzer_local_only@127.0.0.1:5433/brawzer

# Valkey (open-source, Redis-compatible). Any Redis-protocol server works.
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# Mailpit catches all outgoing email locally: inbox at http://localhost:8125
MAILPIT_SMTP_PORT=1125
MAILPIT_UI_PORT=8125

# ── Proxy tests (ADR 0010) ───────────────────────────────────────────────────
# Proxy tests fetch this URL through the proxy; it answers with the caller's
# IP address. Defaults to this API's own /api/v1/network/echo. Production
# must set an https URL.
# PROXY_TEST_URL=https://echo.example.com/ip
# Development only, refused in production: lets proxy tests reach private and
# local addresses, so proxies running on this machine can be tested.
PROXY_TEST_ALLOW_PRIVATE=true

# ── Drive storage (S3-compatible object store) ──────────────────────────────
# RustFS from `pnpm infra:up` locally; any S3-compatible store in production
# (an https endpoint, or no endpoint for AWS S3 itself). Keys may be omitted in
# production when the host provides credentials (such as an IAM role).
STORAGE_ENDPOINT=http://127.0.0.1:9100
STORAGE_REGION=us-east-1
STORAGE_BUCKET=brawzer-drive
STORAGE_ACCESS_KEY_ID=brawzer_local_only
STORAGE_SECRET_ACCESS_KEY=brawzer_local_only
# Path-style URLs (bucket in the path): needed by most self-hosted stores.
STORAGE_FORCE_PATH_STYLE=true

# ── Malware scanning (ClamAV clamd, required for Drive uploads) ─────────────
# Uploads are refused when clamd can't be reached: nothing is stored unscanned.
# clamd must accept streams of at least 100 MiB (CLAMD_CONF_StreamMaxLength in
# the compose files); Drive's limits themselves live in @brawzer/contracts.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Tests only: lowers Drive's per-file limit. Refused in production.
# DRIVE_MAX_FILE_BYTES=3145728

# ── Cloud browser runtime (Phase 3) ─────────────────────────────────────────
# Browser sessions run as containers on the local Docker engine, one per
# session, from the image built with `pnpm runtime:build`. DOCKER_HOST may
# name the engine's socket; by default the usual locations are tried.
# DOCKER_HOST=unix:///var/run/docker.sock
# Production (ADR 0016): a runtime host's engine over mutual TLS, PEM files
# as Docker's own client expects them; required for a tcp:// engine there.
# DOCKER_HOST=tcp://runtime.internal:2376
# Several runtime hosts instead of one (Phase 8): a JSON array of
# { name, docker, agentHost?, agentBind?, capacity }; the first is primary.
# RUNTIME_HOSTS=[{"name":"rt-1","docker":"tcp://rt1.internal:2376","capacity":3}]
# DOCKER_TLS_CA=/run/docker-tls/ca.pem
# DOCKER_TLS_CERT=/run/docker-tls/cert.pem
# DOCKER_TLS_KEY=/run/docker-tls/key.pem
# Where the engine binds the agent ports it publishes and where the API
# reaches them: loopback for a local engine; every interface of the runtime
# host and the engine's host name for a remote one (firewall it to the API).
# BROWSER_AGENT_BIND=0.0.0.0
# BROWSER_AGENT_HOST=runtime.internal
# Where sessions run, shown in the Browser page's status bar, e.g. Frankfurt.
# BROWSER_REGION=
# An OCI runtime registered with the engine for session containers (gVisor).
# BROWSER_CONTAINER_RUNTIME=runsc
# Live sessions across the installation; starting more answers 503.
# BROWSER_MAX_LIVE_SESSIONS=200
# Container pairs this API instance keeps waiting, so a Bee session without a
# proxy or site rules starts at once. Each holds the runtime's memory limit.
# BROWSER_WARM_POOL=0
BROWSER_RUNTIME_IMAGE=brawzer-runtime:dev
# BROWSER_RUNTIME_NETWORK=brawzer-runtime
# Where the Browser page opens the stream WebSocket (the web server's /api/v1
# rewrite can't carry WebSockets). Defaults to this API's own address;
# production must set a wss:// URL on the same site, behind the reverse proxy.
# BROWSER_STREAM_URL=ws://127.0.0.1:4100
# When the stream's origin differs from the site's (as above), a production
# build of the web app must allow it in the page's connect-src:
# NEXT_PUBLIC_STREAM_ORIGIN=ws://127.0.0.1:4100
# Development and tests only, refused in production: every runtime serves a
# small site at testsite.invalid (HTTP and HTTPS) for the browser tests.
BROWSER_TEST_SITE=true

# ── Egress (Phase 5, ADR 0014) ──────────────────────────────────────────────
# Each session's traffic leaves through an egress container (built by
# `pnpm runtime:build` as well) that applies the address rules and the
# profile's proxy; proxy tests run in a tester container of the same image.
EGRESS_IMAGE=brawzer-egress:dev
# Where proxy tests run: `egress` (the tester container; the only option in
# production) or `inline` (inside the API, for development without Docker).
# PROXY_TEST_RUNNER=egress
# Development only, refused in production: proxies and echo servers that the
# tests run on this machine's loopback are reached from containers under
# this name (Docker Desktop and the CI runner both provide it).
EGRESS_LOOPBACK_HOST=host.docker.internal

# ── Plans and billing (Phase 6, ADR 0015) ───────────────────────────────────
# Without a Stripe key only the free plan exists and the Account page says
# paid plans aren't set up. With one, paid plans come from BILLING_PLANS and
# their prices from Stripe; nothing in the code names a price. Production
# needs a live key and the webhook secret for /api/v1/billing/webhook.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# A JSON list of paid plans: code, name, Stripe price id and limits, e.g.
# [{"code":"plus","name":"Plus","stripePriceId":"price_...","limits":{"profiles":25,"proxies":50,"driveBytes":21474836480,"driveFiles":20000,"driveFolders":2000,"browsingMinutesPerMonth":null,"liveSessions":2}}]
# BILLING_PLANS=
# Tests only, refused in production: a fake Stripe API.
# STRIPE_API_BASE=http://127.0.0.1:4242
# Administrators (comma-separated addresses): they see the Admin page and
# can look accounts up and set plans by hand, each change recorded.
# ADMIN_EMAILS=
