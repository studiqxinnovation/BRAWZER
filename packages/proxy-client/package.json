{
  "name": "@brawzer/proxy-client",
  "version": "0.0.0",
  "private": true,
  "description": "Connecting through a saved proxy (SOCKS4, SOCKS4a, SOCKS5, HTTP, HTTPS) under ADR 0010's rules, and testing one. Shared by the API and the egress service.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@brawzer/contracts": "workspace:*",
    "@brawzer/net-policy": "workspace:*",
    "socks": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
