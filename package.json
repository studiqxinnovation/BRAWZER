{
  "name": "brawzer",
  "version": "0.0.0",
  "private": true,
  "description": "Brawzer — a cloud browser platform. Browse anywhere. Leave nothing behind.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "infra:up": "docker compose --project-directory . -f infra/compose/compose.yaml up -d --wait && node infra/scripts/init-openbao.mjs",
    "infra:down": "docker compose --project-directory . -f infra/compose/compose.yaml down",
    "infra:reset": "docker compose --project-directory . -f infra/compose/compose.yaml down --volumes",
    "infra:status": "docker compose --project-directory . -f infra/compose/compose.yaml ps",
    "infra:logs": "docker compose --project-directory . -f infra/compose/compose.yaml logs --follow",
    "runtime:build": "docker build -f apps/runtime-agent/Dockerfile -t brawzer-runtime:dev .",
    "db:generate": "pnpm --filter @brawzer/db run db:generate",
    "db:migrate": "pnpm --filter @brawzer/db run db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
