# Staging settings. Copy to infra/staging/staging.env (git-ignored) and fill in.
# The stack runs with production rules: HTTPS, Resend for email, a key service
# for encryption, and an https proxy-test URL.

# Database password for the staging Postgres.
POSTGRES_PASSWORD=
# Token for the OpenBao stand-in. Use your managed key service's token instead
# when staging uses one.
VAULT_TOKEN=
# Resend API key and a sender on a domain verified with Resend. Without a real
# key, sign-up and sign-in emails can't be delivered.
RESEND_API_KEY=
EMAIL_FROM=Brawzer <no-reply@example.com>
# Where proxy tests fetch their address through the proxy; must be https.
PROXY_TEST_URL=https://example.com/
# Secret key for the staging object store (RustFS).
STORAGE_SECRET_ACCESS_KEY=
# Local port for https://brawzer.localhost:<port>.
STAGING_PORT=8443
