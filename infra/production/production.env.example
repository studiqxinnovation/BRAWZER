# Production settings for infra/production/compose.yaml. Copy to
# infra/production/production.env (git-ignored) and fill in. The API refuses
# to start with an unsafe production configuration; .env.example documents
# every setting.

# Images from the release workflow, pinned by digest.
API_IMAGE=ghcr.io/example/brawzer-api@sha256:…
WEB_IMAGE=ghcr.io/example/brawzer-web@sha256:…
API_REPLICAS=2
SITE_HOST=brawzer.example

# ── The API ─────────────────────────────────────────────────────────────────
WEB_ORIGIN=https://brawzer.example
DATABASE_URL=postgres://…
REDIS_URL=rediss://…
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Brawzer <no-reply@brawzer.example>
KEY_PROVIDER=vault
VAULT_ADDR=https://…
VAULT_TOKEN=
PROXY_TEST_URL=https://brawzer.example/api/v1/network/echo
STORAGE_ENDPOINT=https://…
STORAGE_REGION=auto
STORAGE_BUCKET=brawzer
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Sessions on the runtime host (ADR 0016) ─────────────────────────────────
DOCKER_HOST=tcp://runtime-1.internal:2376
DOCKER_TLS_DIR=/etc/brawzer/docker-tls
DOCKER_TLS_CA=/run/docker-tls/ca.pem
DOCKER_TLS_CERT=/run/docker-tls/cert.pem
DOCKER_TLS_KEY=/run/docker-tls/key.pem
BROWSER_RUNTIME_IMAGE=ghcr.io/example/brawzer-runtime@sha256:…
EGRESS_IMAGE=ghcr.io/example/brawzer-egress@sha256:…
BROWSER_CONTAINER_RUNTIME=runsc
BROWSER_MAX_LIVE_SESSIONS=200
BROWSER_STREAM_URL=wss://brawzer.example
# A scraper's bearer token for GET /api/metrics (16+ characters, required).
METRICS_TOKEN=

# ── Plans and administrators (optional) ─────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# BILLING_PLANS=[]
# ADMIN_EMAILS=
