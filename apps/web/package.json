{
  "name": "@brawzer/web",
  "version": "0.0.0",
  "private": true,
  "description": "Brawzer web app: public site, sign-in, app shell and browser workspace.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start:standalone": "([ -d public ] && cp -r public .next/standalone/apps/web/ || true) && cp -r .next/static .next/standalone/apps/web/.next/ && HOSTNAME=127.0.0.1 PORT=3100 node .next/standalone/apps/web/server.js"
  },
  "dependencies": {
    "@brawzer/contracts": "workspace:*",
    "@brawzer/ui": "workspace:*",
    "@simplewebauthn/browser": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/turbopack": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "ioredis": "catalog:",
    "jsdom": "catalog:",
    "pg": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
