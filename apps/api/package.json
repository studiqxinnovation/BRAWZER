{
  "name": "@brawzer/api",
  "version": "0.0.0",
  "private": true,
  "description": "Brawzer REST API (/api/v1): accounts, profiles, proxies, Drive, security and billing.",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@brawzer/contracts": "workspace:*",
    "@brawzer/db": "workspace:*",
    "@brawzer/net-policy": "workspace:*",
    "@brawzer/proxy-client": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/websocket": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@node-rs/argon2": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "file-type": "catalog:",
    "otplib": "catalog:",
    "pino": "catalog:",
    "qrcode": "catalog:",
    "socks": "catalog:",
    "stripe": "catalog:",
    "ws": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/ws": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
